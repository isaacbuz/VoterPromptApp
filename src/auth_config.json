    "auth0": {
      "entryPoint": "${AUTH0_SAML_ENTRY_POINT}",
      "issuer": "${AUTH0_SAML_ISSUER}",
      "callbackUrl": "${AUTH0_SAML_CALLBACK_URL}",
      "privateCertPath": "${AUTH0_SAML_PRIVATE_KEY_PATH}",
      "idpCertPath": "${AUTH0_SAML_IDP_CERT_PATH}",
      "spCertPath": "${AUTH0_SAML_SP_CERT_PATH}",
      "connectionName": "Auth0-SAML"
    },
    "okta": {
      "entryPoint": "${OKTA_SAML_ENTRY_POINT}",
      "issuer": "${OKTA_SAML_ISSUER}",
      "callbackUrl": "${OKTA_SAML_CALLBACK_URL}",
      "privateCertPath": "${OKTA_SAML_PRIVATE_KEY_PATH}",
