{
  "provider": "azure",
  "protocol": "SAML",
  "campaignCode": "campaign456",
  "partnerId": "partner123",
  "oidcProviders": {
    "auth0": {
      "domain": "${AUTH0_OIDC_DOMAIN}",
      "clientId": "${AUTH0_OIDC_CLIENT_ID}",
      "redirectUri": "${AUTH0_OIDC_REDIRECT_URI}"
    },
    "okta": {
      "domain": "${OKTA_OIDC_DOMAIN}",
      "clientId": "${OKTA_OIDC_CLIENT_ID}",
      "redirectUri": "${OKTA_OIDC_REDIRECT_URI}"
    },
    "azure": {
      "domain": "${AZURE_OIDC_DOMAIN}",
      "clientId": "${AZURE_OIDC_CLIENT_ID}",
      "redirectUri": "${AZURE_OIDC_REDIRECT_URI}",
      "tenantId": "${AZURE_OIDC_TENANT_ID}",
      "scopes": "${AZURE_OIDC_SCOPES}"
    }
  },
  "samlProviders": {
    "shibboleth": {
      "entryPoint": "${SHIBBOLETH_ENTRY_POINT}",
